rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/journal-media/{journalId}/{mediaId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Immutable ciphertext: retries can use a new random media ID.
      allow create: if resource == null && request.auth != null && request.auth.uid == uid
        && request.resource.size > 0 && request.resource.size <= 20971520
        && request.resource.contentType == 'application/octet-stream'
        && request.resource.metadata.keys().hasOnly(['encryptionVersion'])
        && request.resource.metadata.encryptionVersion == '1';
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
