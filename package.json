{
  "name": "ovi-talk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:dates": "node --experimental-strip-types --test tests/journal-dates.test.mjs",
    "test:vault": "node --experimental-strip-types --test tests/vault.test.mjs",
    "test:checkpoints": "node --import tsx --test tests/checkpoints.test.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-ovi \"node --test tests/firebase-rules.test.mjs\"",
    "test:emulators": "firebase emulators:exec --only auth,firestore,storage --project demo-ovi \"node --import tsx --test tests/firebase-rules.test.mjs tests/firebase-integration.test.ts\""
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "firebase": "^12.13.0",
    "lucide-react": "0.468.0",
    "next": "15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.8",
    "firebase-tools": "^15.37.0",
    "postcss": "^8.5.0",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
